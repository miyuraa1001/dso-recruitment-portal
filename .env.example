# =========================================================================
# TEMPLATE ENVIRONMENT VARIABLES UNTUK VERCEL & LOKAL DEVELOPMENT
# Salin file ini menjadi .env.local untuk testing lokal (JANGAN DI-COMMIT)
# Masukkan variabel ini pada Vercel Dashboard: Project Settings > Environment Variables
# =========================================================================

# 1. URL Web App Google Apps Script hasil Deploy (Exec)
GAS_WEBAPP_URL=https://script.google.com/macros/s/AKfycb.../exec

# 2. Secret Key bersama antara Vercel Serverless dan Google Apps Script
# Ganti dengan string acak rahasia yang kuat (contoh di chat)
API_SECRET_KEY=isi_dengan_secret_key_anda

# 3. PIN / Password Akses untuk Admin HRD membuka Dashboard Pelamar
ADMIN_PIN=isi_pin_admin_anda

